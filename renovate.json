{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "packageRules": [
    {
      "description": "JSR dependencies in deno.json",
      "matchManagers": [
        "deno"
      ],
      "matchDepTypes": [
        "jsr"
      ],
      "groupName": "JSR dependencies",
      "schedule": [
        "* 0-2 * * 1"
      ]
    },
    {
      "description": "NPM dev dependencies in package.json",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "NPM dev dependencies",
      "schedule": [
        "* 0-2 * * 1"
      ]
    },
    {
      "description": "docs/deno.json imports Lume and Lumocs from jsDelivr, tracked by the custom manager below",
      "matchManagers": [
        "deno"
      ],
      "matchFileNames": [
        "docs/deno.json"
      ],
      "enabled": false
    }
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "semanticCommits": "disabled",
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "assignees": [],
  "reviewers": [],
  "customManagers": [
    {
      "description": "Track jsDelivr GitHub imports (Lume, Lumocs) in docs/deno.json via GitHub tags",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docs/deno\\.json$/"
      ],
      "matchStrings": [
        "\"https://cdn\\.jsdelivr\\.net/gh/(?<packageName>[^/@\"]+/[^/@\"]+)@(?<currentValue>[^/\"]+)/\""
      ],
      "depNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
