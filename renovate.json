{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "packageRules": [
    {
      "description": "JSR dependencies in deno.json",
      "matchManagers": [
        "deno"
      ],
      "matchDepTypes": [
        "jsr"
      ],
      "groupName": "JSR dependencies",
      "schedule": [
        "* 0-2 * * 1"
      ]
    },
    {
      "description": "NPM dev dependencies in package.json",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "NPM dev dependencies",
      "schedule": [
        "* 0-2 * * 1"
      ]
    }
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "semanticCommits": "disabled",
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "assignees": [],
  "reviewers": []
}
