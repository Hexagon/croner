{
  "name": "@hexagon/croner",
  "version": "11.0.1-dev.0",
  "exports": "./src/croner.ts",
  "lint": {
    "include": [
      "src",
      "build"
    ]
  },
  "fmt": {
    "include": [
      "src",
      "test",
      "build"
    ],
    "lineWidth": 100
  },
  "test": {
    "include": [
      "test"
    ]
  },
  "tasks": {
    "pre-commit": "deno fmt --check && deno lint && deno check src/croner.ts",
    "test": "deno test --allow-read",
    "check-deps": "deno run -A jsr:@check/deps"
  },
  "imports": {
    "@cross/test": "jsr:@cross/test@~0.0.14",
    "@std/assert": "jsr:@std/assert@~1.0.6"
  },
  "publish": {
    "exclude": [
      "build",
      "docs",
      "test",
      ".github",
      ".gitattributes",
      ".npmrc",
      "croner.png",
      "package.json",
      "SECURITY.md",
      "tsconfig.json"
    ]
  }
}
